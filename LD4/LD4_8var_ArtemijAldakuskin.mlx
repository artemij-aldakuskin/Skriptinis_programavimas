% Artemij Aldakuškin
% Grupe: EDIf-25/1
% Data: 2026-10-12

%1a)
y = linspace(-2,2);
x = linspace(-2,2);
[X Y] = meshgrid(x,y);
D_xy = sin(abs(X + Y) / 20) .* exp(-abs(X + Y));
shading flat
colormap("cool")
view(90,90)
xlabel('X')
ylabel('Y')
zlabel('f(X,Y)')
title('f(X,Y)') 
%b)
O = linspace(0,2*pi);
r = linspace(0,1);
[OO R] = meshgrid(O,r);
x = R .* cos(OO);
y = R .* sin(OO);
D_xy = 1 - 2 .* x.^2 - 3 .* y.^2;
surf(x,y,D_xy)
shading interp
colormap([0 0.5 1; 1 1 0])
view(45,45)
xlabel('X')
ylabel('Y')
zlabel('f(X,Y)')
title('f(X,Y)') 

%papildomas
%a)
x = linspace(-2,2);
y = linspace(-2,2);
[X Y] = meshgrid(x,y);
Z = 1 - (X.^2 + Y.^2);
figure
surf(X,Y,Z)
camlight
%b)
figure
surf(X,Y,Z)
hold on
surfc(X,Y,Z)
%c)
figure
surf(X,Y,Z)
